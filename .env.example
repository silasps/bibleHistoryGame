# ─────────────────────────────────────────────────────────────
# BÍBLIA — POR TRÁS DA HISTÓRIA · variáveis de ambiente
# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Sem as variáveis do Supabase, o app roda em "Demonstração local".
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada no QR code do telão). Em dev pode ficar vazia:
# o app usa a origem do navegador.
NEXT_PUBLIC_SITE_URL=

# Supabase (projeto NOVO, não o do e-cargas)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# anon key (ou publishable key). Pública por natureza; só é usada para
# assinar o canal realtime da sala. As tabelas negam acesso ao anon (RLS).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key (ou secret key). SOMENTE servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: usados pela CLI (supabase link / db push), não pelo app
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Ferramenta editorial interna (/editor). Em `next dev` fica sempre ativa.
ENABLE_EDITOR=false
