# ─────────────────────────────────────────────────────────────
# BÍBLIA — POR TRÁS DA HISTÓRIA · variáveis de ambiente
# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Sem as variáveis do Supabase, o app funciona no modo solo e na
# "Demonstração local"; o modo ao vivo fica indisponível.
# ─────────────────────────────────────────────────────────────

# URL pública do site (usada no QR code do telão). Em dev pode ficar vazia:
# o app usa a origem do navegador. Em produção: https://seu-dominio
NEXT_PUBLIC_SITE_URL=

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# anon (ou publishable) key: só assina o canal realtime da sala.
# As tabelas negam acesso a esta chave (RLS sem policies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role (ou secret) key: SOMENTE servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: protege a criação de salas ao vivo e a Área de preparação.
# Recomendado em produção.
PRESENTER_ACCESS_CODE=

# Só para aplicar migrations pela CLI (não usados pelo app).
# Use a connection string do pooler em modo sessão (IPv4), sem a senha:
#   postgresql://postgres.<ref>@aws-1-<regiao>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Ferramenta editorial interna (/editor). Em `next dev` fica sempre ativa.
ENABLE_EDITOR=false
